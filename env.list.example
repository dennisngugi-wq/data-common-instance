# Copy to env.list (git-ignored) and fill in. No quotes, no spaces around =.
# Data Commons API key from https://apikeys.datacommons.org (the website needs it; the pipeline uses it to resolve
# place names that are not in the built-in gazetteer).
DC_API_KEY=your_key_here
# Required by the website container to start. A real Google Maps key enables Google place search; with the
# placeholder the site uses its own place index (site/static/places.json).
MAPS_API_KEY=not-configured
# Tokens for feeds that need them, referenced in feed files as ${NAME}, e.g.
# MY_API_TOKEN=...

# Copy to .env (git-ignored). scripts/start.sh sets HOST_PROJECT_DIR, HOST_UID and HOST_GID itself on Linux.
HOST_PROJECT_DIR=/home/<you>/Datacommon/Projects/datacommon-project
# Website port (africa-dcp uses 8080, so this instance uses 8090 and both can run side by side).
SITE_PORT=8090
# Daily refresh time in UTC (21:00 UTC = 00:00 Africa/Nairobi).
REFRESH_AT_UTC=21:00
# Refresh when the scheduler starts (true) or only at the nightly time (false).
REFRESH_ON_START=true
# Public URL of the site once it has a domain (Croissant url/publisher). Empty = site_url in config/instance.yaml.
SITE_URL=
